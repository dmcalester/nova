{
  "name": "nova-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "clean:coverage": "rm -rf .nyc_output coverage",
    "pretest": "npm run clean:coverage",
    "pretest:unit": "npm run clean:coverage",
    "pretest:integration": "npm run clean:coverage",
    "pretest:visual": "npm run clean:coverage",
    "pretest:coverage": "npm run clean:coverage",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:integration": "playwright test --project=integration",
    "test:visual": "playwright test --project=visual",
    "test:coverage": "playwright test && npx c8 report --reporter=html",
    "coverage": "npx c8 report --reporter=text"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "c8": "^10.1.3",
    "serve": "^14.2.4"
  }
}
